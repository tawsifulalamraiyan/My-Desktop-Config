{
    "layer": "top",
    "position": "top",
    "height": 34,
    "spacing": 4,

    "modules-left": ["custom/distro", "hyprland/workspaces", "hyprland/window"],
    "modules-center": ["clock"],
    "modules-right": ["network", "pulseaudio", "cpu", "memory", "tray", "custom/power"],

    "custom/distro": {
        "format": " 󰊠 ",
        "on-click": "rofi -show drun",
        "tooltip": false
    },

   "hyprland/workspaces": {
        "disable-scroll": false,
        "all-outputs": true,
        "on-click": "activate",
        "format": "{name}",
        "persistent-workspaces": {
            "1": [],
            "2": [],
            "3": [],
            "4": []
        }
    },

    "hyprland/window": {
        "format": "{initialTitle}",
        "max-length": 40
    },

    "clock": {
        "format": "󱑂 {:%H:%M | %a %d %b}",
        "format-alt": "{:%Y-%m-%d}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>"
    },

    "network": {
        "format-wifi": "",
        "format-ethernet": "󰈀",
        "format-disconnected": "󰤮",
        "on-click": "nm-connection-editor"
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟",
        "format-icons": { "default": ["󰕿", "󰖀", "󰕾"] },
        "on-click": "pavucontrol"
    },

    "cpu": {
        "format": " {usage}%",
        "on-click": "alacritty -e htop" 
    },

    "memory": {
        "format": " {percentage}%",
        "on-click": "alacritty -e htop"
    },

    "custom/power": {
        "format": "⏻",
        //"on-click": "poweroff",
        "tooltip": false
    }
}
